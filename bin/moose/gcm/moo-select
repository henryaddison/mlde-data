#! /bin/bash
# Queuable script for extracting GCM predictor variables from mass archive

#SBATCH --partition=mass
#SBATCH --qos=mass
#SBATCH --account=mass
#SBATCH --time=24:00:00
#SBATCH --mem=16G
#SBATCH --mail-type=FAIL

set -uo pipefail

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

rip_code=$1
suite_id=$2
variable=$3

case $suite_id in
  u-an398)
    tp="1897-1970"
    years=$(seq 1897 1970)
    ;;
  u-ap977)
    tp="1971-2005"
    years=$(seq 2071 2005)
    ;;
  u-ar095)
    tp="2006-2076"
    years=$(seq 2006 2076)
    ;;
  u-au084)
    tp="2077-2099"
    years=$(seq 2077 2099)
    ;;
  *)
    echo "unknown suite id ${suite_id}"
    exit 1
    ;;
esac

case $variable in
  psl)
    stream="apd"
    ;;
  mlqtw)
    stream="ape"
    ;;
  pr)
    stream="apa"
    ;;
  *)
    echo "unknown variable ${variable}"
    exit 1
    ;;
esac

echo ${rip_code} ${suite_id} ${tp} ${variable};

output_base_dir="/gws/ssde/j25a/furflex/henrya/projects/furflex/data/mass-extracts"
output_dir="${output_base_dir}/${suite_id}/${rip_code}/${variable}/data"
mkdir -p ${output_dir}

searchfile_path="${output_dir}/searchfile"

case $variable in
  psl)
    cat > ${searchfile_path} << EOF
begin
stash=16222
end
EOF
    ;;
  mlqtw)
    cat > ${searchfile_path} << EOF
begin
stash=(30201, 30202, 30204, 30205)
lblev=(250, 500, 700, 850)
end
EOF
    ;;
  pr)
    cat > ${searchfile_path} << EOF
begin
stash=5216
end
EOF
    ;;
  *)
    echo "unknown variable ${variable}"
    exit 1
    ;;
esac

set -x
time moo select -I ${output_dir}/searchfile moose:ens/${suite_id}/${rip_code}/${stream}.pp ${output_dir}
s=$?
set +x

if [ $s -eq 0 ] || [ $s -eq 17 ]; then
  echo "DONE ${rip_code} ${suite_id} ${variable}: ${s}";
else
  echo "FAILED ${rip_code} ${suite_id} ${variable}: ${s}"
  exit $s
fi
