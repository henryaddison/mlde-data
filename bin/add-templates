#!/bin/bash

set -euo pipefail

echo "Adding templates to the 5km dataset..."
pixi run mlde-data dataset add-template v3_engwales_ccpm-5km_100x12em_1hr_pr

echo "Adding templates to the 100y 8.8km dataset..."
pixi run mlde-data dataset add-template v3_engwales_ccpm-4x_100x12em_1hr_pr

echo "Adding templates to the 60y 8.8km cCPM dataset..."
pixi run mlde-data dataset add-template engwales_ccpm-4x-cpmgem_12em_1hr_pr_preset_v2

echo "Adding templates to the 60y 8.8km GCM dataset..."
pixi run mlde-data dataset add-template engwales_gcm-4x-cpmgem_12em_1hr_pr_preset_v2 engwales_ccpm-4x-cpmgem_12em_1hr_pr_preset_v2
